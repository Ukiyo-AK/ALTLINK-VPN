APP_ENV=production
APP_NAME=ALTLINK VPN
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=true
SECRET_KEY=change-me-very-long-random-string
SESSION_COOKIE_NAME=altlink_admin_session
SESSION_MAX_AGE_SECONDS=43200
PUBLIC_BASE_URL=https://vpn.example.com
ADMIN_PANEL_BASE_URL=https://vpn.example.com
API_HOST=0.0.0.0
API_PORT=8000
TIMEZONE=Asia/Krasnoyarsk

DATABASE_URL=postgresql+asyncpg://altlink:altlink@postgres:5432/altlink
REDIS_URL=redis://redis:6379/0

REMWAVE_BASE_URL=https://panel.example.com
REMWAVE_API_TOKEN=replace-with-official-remnawave-api-token
REMWAVE_TIMEOUT_SECONDS=20
REMWAVE_MAX_RETRIES=3
REMWAVE_VERIFY_TLS=true

CLIENT_BOT_TOKEN=replace-with-client-bot-token
ADMIN_BOT_TOKEN=replace-with-admin-bot-token
ADMIN_TELEGRAM_IDS=123456789
BOT_HEARTBEAT_INTERVAL_SECONDS=30

TRIAL_DURATION_DAYS=2
GRACE_PERIOD_DAYS=14
LOW_BALANCE_THRESHOLD_RUB=50
LOW_BALANCE_NOTIFY_DAYS=5
TRAFFIC_NOTIFY_THRESHOLDS=70,90,100

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_API=60/minute

