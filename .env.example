APP_NAME=ALTLINK VPN
ENVIRONMENT=production
DEBUG=false
TIMEZONE=Asia/Krasnoyarsk
SECRET_KEY=change-me-super-secret
SESSION_SECRET_KEY=change-me-another-secret
ADMIN_API_KEY=change-me-admin-api-key

DATABASE_URL=postgresql+asyncpg://altlink:altlink@postgres:5432/altlink
SQL_ECHO=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000

CLIENT_BOT_TOKEN=replace-client-bot-token
ADMIN_BOT_TOKEN=replace-admin-bot-token
ADMIN_ALLOWED_TELEGRAM_IDS=123456789
CLIENT_BOT_NAME=altlink
ADMIN_BOT_NAME=admin altlink bot
REQUIRED_SUBSCRIPTION_CHANNEL=@altlink_channel
REQUIRED_SUBSCRIPTION_CHANNEL_URL=https://t.me/altlink_channel
TELEGRAM_AUTH_MAX_AGE_SECONDS=300

REMNAWAVE_BASE_URL=https://your-remnawave.example.com
REMNAWAVE_API_TOKEN=replace-remnawave-api-token
REMNAWAVE_TIMEOUT_SECONDS=20
REMNAWAVE_RETRY_ATTEMPTS=3
REMNAWAVE_SUBSCRIPTION_BASE_URL=

DEFAULT_CURRENCY=RUB
TRIAL_DURATION_DAYS=2
BILLING_PERIOD_DAYS=30
GRACE_PERIOD_DAYS=14
LOW_BALANCE_THRESHOLD_RUB=50
UNLIMITED_PLAN_PRICE_RUB=200
SINGLE_SERVER_PLAN_PRICE_RUB=69
WHITELIST_PRICE_PER_GB_RUB=4
PAYMENT_PROVIDER=manual
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
YOOKASSA_TIMEOUT_SECONDS=20
TRAFFIC_NOTIFICATION_THRESHOLDS=70,90,100

SYNC_SERVERS_INTERVAL_MINUTES=30
BILLING_INTERVAL_MINUTES=60
TRAFFIC_SNAPSHOT_INTERVAL_MINUTES=10
NOTIFICATION_DISPATCH_INTERVAL_MINUTES=2
REMNAWAVE_HEALTHCHECK_INTERVAL_MINUTES=5
SERVER_LATENCY_MONITOR_INTERVAL_MINUTES=360
ONLINE_REFRESH_INTERVAL_MINUTES=30
USER_ABUSE_MONITOR_INTERVAL_MINUTES=5
USER_ABUSE_UNIQUE_IP_THRESHOLD=5
USER_ABUSE_IP_FETCH_POLL_ATTEMPTS=5
USER_ABUSE_IP_FETCH_POLL_DELAY_SECONDS=1
USER_ABUSE_HWID_FETCH_CONCURRENCY=8
USER_ABUSE_DAILY_TRAFFIC_GB=50
USER_ABUSE_MONTHLY_TRAFFIC_GB=1024
VLESS_KEYS_DOWNLOAD_COOLDOWN_SECONDS=300
LATENCY_PROBE_SCHEME=https
LATENCY_PROBE_PORT=44443
LATENCY_PROBE_PATH=/ping
BROWSER_LATENCY_TIMEOUT_MS=4000

HEARTBEAT_MAX_AGE_SECONDS=180
